# GEMINI_API_KEY: Required server-side secret for image generation endpoint.
# For Cloudflare Pages production, set this in Project Settings -> Environment Variables.
GEMINI_API_KEY="gen-lang-client"

# VITE_GEMINI_API_KEY: Not required for production.
# Keep unset so the API key is never shipped to browsers.
# VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
